# ---------------------------------------------------------------------------
# ArenaX environment variables
# Copy to:  arenax/apps/mobile/.env      (Expo reads EXPO_PUBLIC_* at build time)
# Copy to:  arenax/apps/admin/.env.local (Next.js admin console)
# Copy to:  arenax/supabase/functions/.env (local edge functions)
# Never commit real values.
# ---------------------------------------------------------------------------

# --- Supabase (from `supabase start` locally or Supabase dashboard) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-side only. NEVER expose this in the mobile app or a public bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Mobile (apps/mobile/.env) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Google sign-in (OAuth web client id). Phone OTP is configured in Supabase Auth.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional: ads. Use Google's test IDs in development (already the app.json default).
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID_ID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS_ID=

# Optional: analytics (PostHog). Empty = analytics calls are no-ops.
EXPO_PUBLIC_POSTHOG_KEY=

# --- Admin console (apps/admin/.env.local) ---
# Same project, anon key only. Admin/ organizer access is enforced by RLS + RPCs.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Edge function secrets (supabase secrets set ...) ---
# Cron worker auth (reveal-rooms). Any long random string.
CRON_SECRET=change-me
# Expo push access token (optional, recommended for production volumes).
EXPO_ACCESS_TOKEN=
# "production" makes rewarded-ad claims use the admob provider instead of test.
ADMOB_ENV=development

# Google Play Billing verification (verify-play-purchase)
# Paste the service account JSON as a single line.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
ANDROID_PACKAGE_NAME=com.arenax.app
VIP_PRODUCT_IDS=arenax_vip_monthly,arenax_vip_yearly

# --- EAS (only needed when building with `eas build`) ---
EAS_PROJECT_ID=
